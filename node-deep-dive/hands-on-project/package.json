{
  "name": "node-deep-dive-order-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "NODE_ENV=development node src/server.js",
    "dev:memory": "NODE_ENV=development DB_MODE=memory CACHE_MODE=memory node src/server.js",
    "test": "node --test",
    "event-loop": "node scripts/event-loop-demo.mjs",
    "child-process": "node scripts/child-process-demo.mjs",
    "payment-stub": "node scripts/payment-stub.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs --tail=100"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "redis": "^5.8.1"
  }
}
